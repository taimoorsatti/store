<section class="newsletter-section" style="padding: 6rem 0; background: var(--color-bg); text-align: center; border-bottom: 1px solid var(--color-border);">
  <div class="container" style="max-width: 680px; background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 3.5rem 2rem; box-shadow: var(--shadow-sm);">
    <span style="font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; display: block; margin-bottom: 0.75rem;">
      {{ section.settings.badge | default: 'VIP BEAUTY CIRCLE PRIVILEGES' }}
    </span>
    <h2 style="font-size: 2.25rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.75rem; line-height: 1.2;">
      {{ section.settings.heading | default: 'Join the FABFaddons VIP Beauty Circle.' }}
    </h2>
    <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 2rem; line-height: 1.6;">
      {{ section.settings.text | default: 'Receive private invitations to new formulation drops, aesthetician ritual guides, and complimentary gift privileges across the UAE.' }}
    </p>

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display: flex; gap: 0.6rem; max-width: 480px; margin: 0 auto; flex-wrap: wrap;">
        <input
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="Enter your email address"
          required
          style="flex: 2; min-width: 200px; padding: 0.9rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.875rem; background: var(--color-bg); color: var(--color-text);"
        >
        <button type="submit" class="btn-primary" style="flex: 1; min-width: 130px; font-size: 11px;">
          Join Circle
        </button>
      </div>
    {% endform %}
    <p style="font-size: 0.72rem; color: var(--color-text-muted); margin-top: 1rem; opacity: 0.8;">
      We respect your privacy. Unsubscribe at any time.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow badge",
      "default": "VIP BEAUTY CIRCLE PRIVILEGES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the FABFaddons VIP Beauty Circle."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Receive private invitations to new formulation drops, aesthetician ritual guides, and complimentary gift privileges across the UAE."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
