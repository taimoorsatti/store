<section style="padding: 4rem 0; background: var(--color-bg);">
  <div class="container" style="max-width: 800px;">
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <h1 style="font-size: 2.5rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.5rem;">
        {{ page.title | default: 'Frequently Asked Questions' }}
      </h1>
      <p style="color: var(--color-text-muted); font-size: 1rem;">
        Everything you need to know about UAE ordering, express shipping, and authenticity.
      </p>
    </div>

    <div style="background: #FFFFFF; border-radius: 12px; border: 1px solid var(--color-secondary-bg); overflow: hidden; padding: 1.5rem;">
      <div class="accordion-item">
        <button class="accordion-header">How fast is delivery within the UAE?</button>
        <div class="accordion-content">
          We offer express delivery across the UAE. Orders in Dubai, Abu Dhabi, and Sharjah typically arrive within 24 to 48 hours. Deliveries to the Northern Emirates take 2 to 3 business days.
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">What payment methods do you accept?</button>
        <div class="accordion-content">
          We accept Visa, Mastercard, Apple Pay, and Cash on Delivery (COD). We also support installment options via Tabby and Tamara during checkout.
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">Are your beauty devices and skincare products 100% authentic?</button>
        <div class="accordion-content">
          Yes, absolutely. All FABFaddons devices and formulas are sourced through certified manufacturers adhering to EU and UAE regulatory standards. Electronic devices include a 1-year replacement warranty.
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">What is your return and exchange policy?</button>
        <div class="accordion-content">
          We offer a 14-day hassle-free return window on unused, unopened items in original packaging. Devices with manufacturing defects are covered under our 1-year replacement warranty.
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ Page",
  "settings": []
}
{% endschema %}
