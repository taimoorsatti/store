<section style="padding: 4rem 0; background: var(--color-bg);">
  <div class="container" style="max-width: 860px;">
    <h1 style="font-size: 2.5rem; font-weight: 700; color: var(--color-primary); margin-bottom: 2rem; text-align: center;">
      {{ page.title | default: 'Store Policy' }}
    </h1>

    <div style="background: #FFFFFF; padding: 2.5rem; border-radius: 12px; border: 1px solid var(--color-secondary-bg); line-height: 1.8; color: var(--color-text);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Policy Content",
  "settings": []
}
{% endschema %}
