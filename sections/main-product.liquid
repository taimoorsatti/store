<section class="main-product-section" style="padding: 4rem 0 6rem; background: var(--color-bg);">
  <div class="container">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 2rem;">
      <a href="{{ routes.root_url }}">Home</a>
      <span style="margin: 0 0.5rem;">/</span>
      <a href="{{ routes.all_products_collection_url }}">Catalog</a>
      <span style="margin: 0 0.5rem;">/</span>
      <span style="color: var(--color-primary); font-weight: 700;">{{ product.title }}</span>
    </nav>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 4.5rem; align-items: start;">
      <!-- Product Gallery Column -->
      <div class="product-gallery">
        <div style="border-radius: var(--radius-lg); overflow: hidden; background: #FFFFFF; border: 1px solid var(--color-border); aspect-ratio: 1; box-shadow: var(--shadow-sm); position: relative;">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'eager', style: 'width: 100%; height: 100%; object-fit: cover;', id: 'product-featured-media' }}
          {%- else -%}
            <img src="{{ 'product-sonic-cleansing-device.jpg' | asset_url }}" id="product-featured-media" alt="{{ product.title }}" style="width: 100%; height: 100%; object-fit: cover;">
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            <div style="position: absolute; top: 16px; left: 16px; background: var(--color-primary); color: #FFF; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: var(--radius-sm); letter-spacing: 0.05em;">
              SAVE {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%
            </div>
          {%- endif -%}
        </div>

        <!-- Thumbnails -->
        {%- if product.media.size > 1 -%}
          <div style="display: flex; gap: 0.875rem; margin-top: 1rem; overflow-x: auto; padding-bottom: 0.5rem;">
            {%- for media in product.media -%}
              <button type="button" onclick="document.getElementById('product-featured-media').src='{{ media | image_url: width: 900 }}'" style="width: 76px; height: 76px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-border); flex-shrink: 0; background: #FFFFFF; cursor: pointer; transition: border-color 0.2s ease;">
                {{ media | image_url: width: 150 | image_tag: style: 'width: 100%; height: 100%; object-fit: cover;' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Purchase & Product Info Column -->
      <div style="background: #FFFFFF; padding: 2.5rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-md);">
        
        <!-- Category & Availability Tag -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <span style="font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent); font-weight: 700;">
            {{ product.type | default: 'HAUTE BEAUTÉ' }}
          </span>
          <span style="font-size: 0.72rem; font-weight: 700; color: #047857; background: #ECFDF5; padding: 3px 8px; border-radius: 4px; display: inline-flex; align-items: center; gap: 4px;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #047857;"></span>
            {{ 'products.product.in_stock' | t | default: 'In Stock · Ready to Ship' }}
          </span>
        </div>

        <h1 style="font-size: 2.25rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-primary); line-height: 1.2;">
          {{ product.title }}
        </h1>

        <!-- Price Display -->
        <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--color-border);">
          <span data-product-price style="font-size: 1.75rem; font-weight: 700; color: var(--color-primary);">
            {{ product.selected_or_first_available_variant.price | money }}
          </span>
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
            <span data-product-compare-price style="font-size: 1.15rem; color: var(--color-text-muted); text-decoration: line-through;">
              {{ product.selected_or_first_available_variant.compare_at_price | money }}
            </span>
          {%- endif -%}
        </div>

        <!-- UAE Dispatch Guarantee Box -->
        <div style="background: var(--color-bg); padding: 1rem 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); margin-bottom: 1.75rem; font-size: 0.825rem; color: var(--color-text); line-height: 1.5;">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.35rem;">
            <span>🚚</span>
            <span>UAE Express Delivery (1–2 business days across Dubai & Abu Dhabi)</span>
          </div>
          <div style="color: var(--color-text-muted); font-size: 0.78rem;">
            Cash on Delivery (COD) & Apple Pay supported at checkout.
          </div>
        </div>

        <!-- Add to Cart Form -->
        {% form 'product', product, id: 'product-form' %}
          <!-- Variant Selector -->
          {%- if product.variants.size > 1 -%}
            <div style="margin-bottom: 1.75rem;">
              <label style="display: block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.65rem; color: var(--color-primary);">
                Select Edition / Variant:
              </label>
              <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
                {%- for variant in product.variants -%}
                  <label class="variant-pill-label {% if forloop.first %}is-active{% endif %}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.15rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.825rem; cursor: pointer; background: var(--color-bg); font-weight: 600; transition: all 0.2s ease;">
                    <input type="radio" name="id" value="{{ variant.id }}" data-price="{{ variant.price | money }}" data-compare-price="{{ variant.compare_at_price | money }}" data-available="{{ variant.available }}" {% if forloop.first %}checked{% endif %} style="accent-color: var(--color-primary);">
                    <span>{{ variant.title }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- endif -%}

          <!-- Quantity Stepper & Add to Bag -->
          <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
            <div style="display: flex; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg);">
              <button type="button" data-quantity-btn="minus" style="padding: 0.85rem 1.15rem; color: var(--color-text); font-size: 1.1rem; font-weight: 700;">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" style="width: 50px; text-align: center; border: none; font-size: 0.95rem; font-weight: 700; background: transparent; color: var(--color-primary);">
              <button type="button" data-quantity-btn="plus" style="padding: 0.85rem 1.15rem; color: var(--color-text); font-size: 1.1rem; font-weight: 700;">&plus;</button>
            </div>

            <button type="submit" data-add-to-cart-button class="btn-primary" style="flex: 1;" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
            </button>
          </div>

          <!-- Instant Buy Now -->
          {% if form %}
            {{ form | payment_button }}
          {% endif %}
        {% endform %}

        <!-- Tabbed Information Accordions -->
        <div style="margin-top: 2.25rem; border-top: 1px solid var(--color-border); padding-top: 1rem;">
          <!-- Accordion 1: Description -->
          <div class="accordion-item">
            <button type="button" class="accordion-header">
              <span>Ritual & Description</span>
              <span class="accordion-icon" style="font-size: 1.25rem; font-weight: 400; color: var(--color-accent); margin-left: 1rem;">+</span>
            </button>
            <div class="accordion-content">
              {{ product.description }}
            </div>
          </div>

          <!-- Accordion 2: Clinical Efficacy & Features -->
          <div class="accordion-item">
            <button type="button" class="accordion-header">
              <span>Clinical Features & Technology</span>
              <span class="accordion-icon" style="font-size: 1.25rem; font-weight: 400; color: var(--color-accent); margin-left: 1rem;">+</span>
            </button>
            <div class="accordion-content">
              Medical-grade acoustic transducer delivering up to 8,000 vibrations per minute. Waterproof IPX7 engineering allows safe in-shower cleansing and effortless rinsing under running water.
            </div>
          </div>

          <!-- Accordion 3: UAE Delivery & Warranty -->
          <div class="accordion-item">
            <button type="button" class="accordion-header">
              <span>UAE Shipping, COD & Warranty</span>
              <span class="accordion-icon" style="font-size: 1.25rem; font-weight: 400; color: var(--color-accent); margin-left: 1rem;">+</span>
            </button>
            <div class="accordion-content">
              Orders placed before 2:00 PM are dispatched same-day with delivery in 1–2 business days across all UAE Emirates. 1-year replacement warranty on all electronics. 14-day warranty returns on sealed cosmetics.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {%- if recommendations.products.size > 0 or collections.all.products.size > 1 -%}
      <div style="margin-top: 6rem; padding-top: 4rem; border-top: 1px solid var(--color-border);">
        <div style="text-align: center; margin-bottom: 3rem;">
          <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; display: block; margin-bottom: 0.5rem;">
            PERFECT PAIRINGS
          </span>
          <h2 style="font-size: 2.25rem; font-weight: 700; color: var(--color-primary);">
            Complement Your Daily Ritual
          </h2>
        </div>

        <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
          {%- for rel_product in collections.all.products limit: 3 -%}
            {%- if rel_product.id != product.id -%}
              {% render 'product-card', product: rel_product %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Information",
  "settings": []
}
{% endschema %}
