<section class="featured-collection-section" style="padding: 5rem 0; background: #FFFFFF; border-top: 1px solid var(--color-secondary-bg);">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: center; margin-bottom: 3.5rem;">
      <div>
        <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; display: block; margin-bottom: 0.75rem;">
          {{ section.settings.badge | default: 'SPOTLIGHT CURATION' }}
        </span>
        <h2 style="font-size: 2.5rem; font-weight: 700; color: var(--color-primary); line-height: 1.15; margin-bottom: 1rem;">
          {{ section.settings.title | default: 'The Signature Ritual' }}
        </h2>
        <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem;">
          {{ section.settings.text | default: 'Formulated for UAE climates and humidity. Pair deep micro-sonic exfoliation with chilled Brazilian rose quartz to stimulate natural collagen, brighten dull complexions, and sculpt contour lines.' }}
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn-primary">
            {{ section.settings.button_label | default: 'Explore Featured Ritual' }}
          </a>
          <a href="/pages/about" class="btn-secondary">
            Our Formulation Science
          </a>
        </div>
      </div>

      <div>
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 20px 40px rgba(53, 28, 39, 0.1); border: 1px solid var(--color-secondary-bg);">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', style: 'width: 100%; height: auto; display: block;' }}
          {%- else -%}
            <img src="{{ 'campaign-editorial-banner.jpg' | asset_url }}" alt="Featured Collection Ritual" style="width: 100%; height: auto; display: block;">
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Product Grid for Featured Collection -->
    <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow badge",
      "default": "SPOTLIGHT CURATION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Signature Ritual"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Formulated for UAE climates and humidity. Pair deep micro-sonic exfoliation with chilled Brazilian rose quartz to stimulate natural collagen, brighten dull complexions, and sculpt contour lines."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial banner"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Featured Ritual"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
