<section class="collection-page" style="padding: 3rem 0 5rem; background: var(--color-bg);">
  <div class="container">
    <!-- Breadcrumb & Collection Header -->
    <div style="margin-bottom: 2.5rem; text-align: center;">
      <nav aria-label="Breadcrumb" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 0.75rem;">
        <a href="{{ routes.root_url }}" style="color: var(--color-text-muted);">Home</a>
        <span style="margin: 0 0.5rem;">/</span>
        <span style="color: var(--color-primary); font-weight: 600;">{{ collection.title | default: 'Shop All' }}</span>
      </nav>
      <h1 style="font-size: 2.75rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.75rem; letter-spacing: -0.02em;">
        {{ collection.title | default: 'The Launch Collection' }}
      </h1>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; max-width: 640px; margin: 0 auto; line-height: 1.6;">
        {{ collection.description | default: 'Discover our complete curation of medical-grade skincare devices, botanical elixirs, and luxury vanity essentials.' }}
      </p>
    </div>

    <!-- Mobile Filter & Sort Trigger Bar -->
    <div class="collection-mobile-bar" style="display: none; margin-bottom: 1.5rem; justify-content: space-between; align-items: center; background: #FFFFFF; padding: 0.875rem 1.25rem; border: 1px solid var(--color-secondary-bg); border-radius: 4px;">
      <button type="button" id="open-filter-drawer" style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.05em;">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
        <span>{{ 'sections.collection_template.filter_and_sort' | t }}</span>
        {%- assign total_active_filters = 0 -%}
        {%- for filter in collection.filters -%}
          {%- assign total_active_filters = total_active_filters | plus: filter.active_values.size -%}
          {%- if filter.type == 'price_range' and filter.min_value.value != nil or filter.max_value.value != nil -%}
            {%- assign total_active_filters = total_active_filters | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if total_active_filters > 0 -%}
          <span style="background: var(--color-primary); color: #FFF; border-radius: 50%; width: 18px; height: 18px; font-size: 10px; display: inline-flex; align-items: center; justify-content: center;">{{ total_active_filters }}</span>
        {%- endif -%}
      </button>

      <span style="font-size: 0.8rem; color: var(--color-text-muted);">
        {{ 'sections.collection_template.product_count' | t: count: collection.products_count }}
      </span>
    </div>

    <!-- Main Layout: Sidebar + Product Grid -->
    <div class="collection-layout" style="display: grid; grid-template-columns: 260px 1fr; gap: 3rem; align-items: start;">
      
      <!-- DESKTOP FILTER SIDEBAR -->
      <aside class="collection-sidebar" style="background: #FFFFFF; border: 1px solid var(--color-secondary-bg); border-radius: 6px; padding: 1.5rem; position: sticky; top: 6.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-secondary-bg);">
          <span style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700; color: var(--color-primary);">
            {{ 'sections.collection_template.filter_by_label' | t }}
          </span>
          {%- if total_active_filters > 0 -%}
            <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" style="font-size: 0.75rem; color: var(--color-accent); font-weight: 700; text-decoration: underline;">
              {{ 'sections.collection_template.clear_all' | t }}
            </a>
          {%- endif -%}
        </div>

        <form id="CollectionFiltersForm" method="get" action="{{ collection.url }}">
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          
          <div class="filter-groups-wrapper" style="display: flex; flex-direction: column; gap: 1.5rem;">
            {%- for filter in collection.filters -%}
              <div class="filter-group-block" style="border-bottom: 1px solid rgba(233, 223, 213, 0.7); padding-bottom: 1.25rem;">
                <div style="font-size: 0.85rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; display: flex; justify-content: space-between;">
                  <span>{{ filter.label }}</span>
                  {%- if filter.active_values.size > 0 -%}
                    <span style="color: var(--color-accent); font-size: 0.75rem;">({{ filter.active_values.size }})</span>
                  {%- endif -%}
                </div>

                {%- case filter.type -%}
                  {%- when 'list' or 'boolean' -%}
                    <div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 220px; overflow-y: auto;">
                      {%- for filter_value in filter.values -%}
                        <label style="display: flex; align-items: center; justify-content: space-between; font-size: 0.825rem; color: var(--color-text); cursor: pointer; user-select: none;">
                          <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="checkbox"
                              name="{{ filter_value.param_name }}"
                              value="{{ filter_value.value }}"
                              {% if filter_value.active %}checked{% endif %}
                              {% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
                              onchange="this.form.submit()"
                              style="width: 15px; height: 15px; accent-color: var(--color-primary);">
                            <span {% if filter_value.active %}style="font-weight: 700; color: var(--color-primary);"{% endif %}>{{ filter_value.label }}</span>
                          </div>
                          <span style="color: var(--color-text-muted); font-size: 0.75rem;">({{ filter_value.count }})</span>
                        </label>
                      {%- endfor -%}
                    </div>

                  {%- when 'price_range' -%}
                    <div>
                      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.75rem;">
                        <div>
                          <label style="font-size: 0.7rem; color: var(--color-text-muted); display: block; margin-bottom: 2px;">{{ 'sections.collection_template.from' | t }}</label>
                          <input type="number"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value | default: '' }}"
                            placeholder="0"
                            min="0"
                            max="{{ filter.range_max }}"
                            style="width: 100%; padding: 0.45rem; border: 1px solid var(--color-secondary-bg); border-radius: 3px; font-size: 0.8rem;">
                        </div>
                        <div>
                          <label style="font-size: 0.7rem; color: var(--color-text-muted); display: block; margin-bottom: 2px;">{{ 'sections.collection_template.to' | t }}</label>
                          <input type="number"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value | default: '' }}"
                            placeholder="{{ filter.range_max }}"
                            min="0"
                            max="{{ filter.range_max }}"
                            style="width: 100%; padding: 0.45rem; border: 1px solid var(--color-secondary-bg); border-radius: 3px; font-size: 0.8rem;">
                        </div>
                      </div>
                      <button type="submit" class="btn-secondary" style="width: 100%; padding: 0.4rem; font-size: 11px;">
                        {{ 'sections.collection_template.apply' | t }}
                      </button>
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        </form>
      </aside>

      <!-- RIGHT PRODUCT CONTENT AREA -->
      <div>
        <!-- Top Toolbar: Active Chips & Sorting Dropdown -->
        <div style="background: #FFFFFF; border: 1px solid var(--color-secondary-bg); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          
          <!-- Product count summary -->
          <div style="font-size: 0.85rem; font-weight: 600; color: var(--color-primary);">
            <span>{{ 'sections.collection_template.product_count' | t: count: collection.products_count }}</span>
          </div>

          <!-- Sort Selector -->
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <label for="SortBySelect" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted);">
              {{ 'sections.collection_template.sort_by_label' | t }}:
            </label>
            <select id="SortBySelect" name="sort_by" onchange="window.location.href = updateQueryStringParameter(window.location.href, 'sort_by', this.value);" style="padding: 0.5rem 1rem; border: 1px solid var(--color-secondary-bg); border-radius: 4px; font-size: 0.825rem; font-family: inherit; color: var(--color-primary); background: var(--color-bg); cursor: pointer; font-weight: 600;">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected="selected"{% endif %}>
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        </div>

        <!-- Active Filter Chips Bar -->
        {%- assign has_active_filters = false -%}
        <div class="active-filter-chips" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; align-items: center;">
          {%- for filter in collection.filters -%}
            {%- for filter_value in filter.active_values -%}
              {%- assign has_active_filters = true -%}
              <a href="{{ filter_value.url_to_remove }}" style="display: inline-flex; align-items: center; gap: 0.4rem; background: var(--color-primary); color: #FFF; font-size: 11px; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 20px; text-decoration: none; transition: opacity 0.2s;">
                <span>{{ filter.label }}: {{ filter_value.label }}</span>
                <span style="font-size: 14px; line-height: 1;">&times;</span>
              </a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' and filter.min_value.value != nil or filter.max_value.value != nil -%}
              {%- assign has_active_filters = true -%}
              <a href="{{ filter.url_to_remove }}" style="display: inline-flex; align-items: center; gap: 0.4rem; background: var(--color-primary); color: #FFF; font-size: 11px; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 20px; text-decoration: none;">
                <span>AED {{ filter.min_value.value | default: 0 }} &ndash; AED {{ filter.max_value.value | default: filter.range_max }}</span>
                <span style="font-size: 14px; line-height: 1;">&times;</span>
              </a>
            {%- endif -%}
          {%- endfor -%}

          {%- if has_active_filters -%}
            <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="btn-secondary" style="padding: 0.3rem 0.75rem; font-size: 11px; border-radius: 20px;">
              {{ 'sections.collection_template.clear_all' | t }}
            </a>
          {%- endif -%}
        </div>

        <!-- Product Grid -->
        <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.75rem;">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- else -%}
            <div style="grid-column: 1 / -1; background: #FFFFFF; border: 1px solid var(--color-secondary-bg); border-radius: 8px; padding: 4rem 2rem; text-align: center;">
              <div style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--color-primary); font-weight: 700; margin-bottom: 0.75rem;">
                {{ 'sections.collection_template.empty' | t }}
              </div>
              <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
                {{ 'sections.collection_template.use_fewer_filters' | t }}
              </p>
              <a href="{{ collection.url }}" class="btn-primary">
                {{ 'sections.collection_template.clear_all' | t }}
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <!-- MOBILE SLIDE-OUT FILTER DRAWER -->
  <div id="filter-drawer-overlay" class="cart-drawer-overlay"></div>
  <aside id="filter-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.collection_template.filter_and_sort' | t }}" style="max-width: 380px;">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--color-secondary-bg); display: flex; align-items: center; justify-content: space-between; background: #FFFFFF;">
      <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--color-primary);">
        {{ 'sections.collection_template.filter_and_sort' | t }}
      </h2>
      <button type="button" id="close-filter-drawer" aria-label="Close filter drawer" style="font-size: 1.5rem; color: var(--color-text-muted); line-height: 1;">&times;</button>
    </div>

    <form id="MobileFiltersForm" method="get" action="{{ collection.url }}" style="flex: 1; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem;">
      <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
      
      <!-- Mobile Sort Option -->
      <div style="border-bottom: 1px solid var(--color-secondary-bg); padding-bottom: 1.25rem;">
        <label for="MobileSortBy" style="font-size: 0.85rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; margin-bottom: 0.5rem; display: block;">
          {{ 'sections.collection_template.sort_by_label' | t }}
        </label>
        <select id="MobileSortBy" name="sort_by" style="width: 100%; padding: 0.65rem; border: 1px solid var(--color-secondary-bg); border-radius: 4px; font-size: 0.85rem;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected="selected"{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </div>

      <!-- Mobile Filters -->
      {%- for filter in collection.filters -%}
        <div style="border-bottom: 1px solid var(--color-secondary-bg); padding-bottom: 1.25rem;">
          <div style="font-size: 0.85rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; margin-bottom: 0.75rem;">
            {{ filter.label }}
          </div>

          {%- case filter.type -%}
            {%- when 'list' or 'boolean' -%}
              <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                {%- for filter_value in filter.values -%}
                  <label style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <input type="checkbox"
                        name="{{ filter_value.param_name }}"
                        value="{{ filter_value.value }}"
                        {% if filter_value.active %}checked{% endif %}
                        style="width: 16px; height: 16px; accent-color: var(--color-primary);">
                      <span>{{ filter_value.label }}</span>
                    </div>
                    <span style="color: var(--color-text-muted); font-size: 0.75rem;">({{ filter_value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>

            {%- when 'price_range' -%}
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                <div>
                  <span style="font-size: 0.7rem; color: var(--color-text-muted);">From</span>
                  <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | default: '' }}" placeholder="0" min="0" style="width: 100%; padding: 0.5rem; border: 1px solid var(--color-secondary-bg); border-radius: 3px;">
                </div>
                <div>
                  <span style="font-size: 0.7rem; color: var(--color-text-muted);">To</span>
                  <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | default: '' }}" placeholder="{{ filter.range_max }}" min="0" style="width: 100%; padding: 0.5rem; border: 1px solid var(--color-secondary-bg); border-radius: 3px;">
                </div>
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}

      <div style="padding-top: 1rem; display: flex; gap: 0.75rem;">
        <a href="{{ collection.url }}" class="btn-secondary" style="flex: 1; text-align: center; font-size: 11px;">
          {{ 'sections.collection_template.clear' | t }}
        </a>
        <button type="submit" class="btn-primary" style="flex: 2; font-size: 11px;">
          {{ 'sections.collection_template.apply' | t }}
        </button>
      </div>
    </form>
  </aside>
</section>

<script>
  function updateQueryStringParameter(uri, key, value) {
    var re = new RegExp("([?&])" + key + "=.*?(&|$)", "i");
    var separator = uri.indexOf('?') !== -1 ? "&" : "?";
    if (uri.match(re)) {
      return uri.replace(re, '$1' + key + "=" + value + '$2');
    } else {
      return uri + separator + key + "=" + value;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.querySelector('#open-filter-drawer');
    const closeBtn = document.querySelector('#close-filter-drawer');
    const drawer = document.querySelector('#filter-drawer');
    const overlay = document.querySelector('#filter-drawer-overlay');

    if (openBtn && drawer && overlay) {
      openBtn.addEventListener('click', () => {
        drawer.classList.add('active');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeFilterDrawer() {
      if (drawer) drawer.classList.remove('active');
      if (overlay) overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (closeBtn) closeBtn.addEventListener('click', closeFilterDrawer);
    if (overlay) overlay.addEventListener('click', closeFilterDrawer);
  });
</script>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
