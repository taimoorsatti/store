<section class="product-spotlight-section" style="padding: 6rem 0; background: #FFFFFF; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 4rem; align-items: center;">
    <!-- Visual Showcase -->
    <div style="position: relative;">
      <div style="border-radius: var(--radius-lg); overflow: hidden; background: #F7F3ED; border: 1px solid var(--color-border); box-shadow: var(--shadow-md);">
        <img src="{{ 'product-sonic-cleansing-device.jpg' | asset_url }}" alt="Featured Product Spotlight" style="width: 100%; height: auto; object-fit: cover;">
      </div>

      <!-- Feature Pill 1 -->
      <div style="position: absolute; top: 10%; right: -15px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid var(--color-border); border-radius: 30px; padding: 0.5rem 1rem; box-shadow: var(--shadow-sm); font-size: 0.75rem; font-weight: 700; color: var(--color-primary); display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: var(--color-accent);">✦</span>
        <span>8,000 Sonic Vibrations / Min</span>
      </div>

      <!-- Feature Pill 2 -->
      <div style="position: absolute; bottom: 12%; left: -15px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid var(--color-border); border-radius: 30px; padding: 0.5rem 1rem; box-shadow: var(--shadow-sm); font-size: 0.75rem; font-weight: 700; color: var(--color-primary); display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: var(--color-accent);">✦</span>
        <span>Medical-Grade Waterproof Silicone</span>
      </div>
    </div>

    <!-- Details Module -->
    <div>
      <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; display: block; margin-bottom: 0.75rem;">
        {{ section.settings.badge | default: 'STAR PRODUCT SPOTLIGHT' }}
      </span>

      <h2 style="font-size: 2.75rem; font-weight: 700; color: var(--color-primary); line-height: 1.15; margin-bottom: 1rem;">
        {{ section.settings.title | default: 'Sonic Facial Sculpting & Deep Cleansing Device' }}
      </h2>

      <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 1.5rem;">
        <span style="font-size: 1.6rem; font-weight: 700; color: var(--color-primary);">AED 349</span>
        <span style="font-size: 1.1rem; color: var(--color-text-muted); text-decoration: line-through;">AED 499</span>
        <span style="background: var(--color-secondary-bg); color: var(--color-primary); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 3px;">SAVE 30%</span>
      </div>

      <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.7; margin-bottom: 2rem;">
        {{ section.settings.description | default: 'Engineered for high-humidity climates. Medical-grade sonic frequencies decongest stubborn pores, accelerate lymphatic drainage, and sculpt cheekbone contours in a 3-minute morning ritual.' }}
      </p>

      <!-- Key Clinical Highlights Grid -->
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; margin-bottom: 2.5rem; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 1.5rem 0;">
        <div>
          <span style="font-size: 1.5rem; font-weight: 700; color: var(--color-primary); display: block; line-height: 1;">96%</span>
          <span style="font-size: 0.8rem; color: var(--color-text-muted);">Reported deeper cleansing & less pore congestion</span>
        </div>
        <div>
          <span style="font-size: 1.5rem; font-weight: 700; color: var(--color-primary); display: block; line-height: 1;">3x</span>
          <span style="font-size: 0.8rem; color: var(--color-text-muted);">Faster bio-cellular serum absorption</span>
        </div>
      </div>

      <!-- Quick Action Form -->
      <form method="post" action="/cart/add" style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <input type="hidden" name="id" value="101">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn-primary" style="flex: 2; min-width: 200px;">
          {{ 'products.product.add_to_cart' | t | default: 'Add to Bag — AED 349' }}
        </button>
        <a href="/products/sonic-cleansing-device" class="btn-secondary" style="flex: 1; min-width: 140px; text-align: center;">
          Full Ritual Details
        </a>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow badge",
      "default": "STAR PRODUCT SPOTLIGHT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Sonic Facial Sculpting & Deep Cleansing Device"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Engineered for high-humidity climates. Medical-grade sonic frequencies decongest stubborn pores, accelerate lymphatic drainage, and sculpt cheekbone contours in a 3-minute morning ritual."
    }
  ],
  "presets": [
    {
      "name": "Product Spotlight"
    }
  ]
}
{% endschema %}
