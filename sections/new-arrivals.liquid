<section class="new-arrivals-section" style="padding: 5rem 0; background: var(--color-bg);">
  <div class="container">
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; display: block; margin-bottom: 0.5rem;">
        {{ section.settings.badge | default: 'JUST LAUNCHED' }}
      </span>
      <h2 style="font-size: 2.25rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.75rem;">
        {{ section.settings.title | default: 'New Arrivals' }}
      </h2>
      <p style="color: var(--color-text-muted); font-size: 1rem; max-width: 600px; margin: 0 auto; line-height: 1.6;">
        {{ section.settings.subtitle | default: 'Engineered with cutting-edge micro-current, phototherapy, and peptide cellular science.' }}
      </p>
    </div>

    <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="product-card" style="padding: 2.5rem; text-align: center; border: 1px solid var(--color-secondary-bg); border-radius: 6px;">
            <p style="font-size: 10px; color: var(--color-accent); font-weight: 700; text-transform: uppercase;">NEW INNOVATION</p>
            <h3 style="font-family: var(--font-heading); font-size: 1.15rem; margin: 0.5rem 0;">New Arrival {{ i }}</h3>
            <p style="color: var(--color-primary); font-weight: 700;">AED 429</p>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow badge",
      "default": "JUST LAUNCHED"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Engineered with cutting-edge micro-current, phototherapy, and peptide cellular science."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
