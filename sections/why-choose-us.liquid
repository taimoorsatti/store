<section class="why-choose-us-section" style="padding: 5.5rem 0; background: #FFFFFF; border-bottom: 1px solid var(--color-border);">
  <div class="container">
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; display: block; margin-bottom: 0.75rem;">
        {{ section.settings.badge | default: 'THE FABFADDONS DISTINCTION' }}
      </span>
      <h2 style="font-size: 2.5rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.75rem;">
        {{ section.settings.heading | default: 'Why Beauty Connoisseurs Choose Us' }}
      </h2>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; max-width: 600px; margin: 0 auto; line-height: 1.6;">
        {{ section.settings.subheading | default: 'Uncompromising standards of quality, dispatch velocity, and concierge client care.' }}
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem;">
      <!-- Pillar 1 -->
      <div style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 2.25rem 1.75rem; transition: transform 0.3s ease;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--color-secondary-bg); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; color: var(--color-primary);">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.5rem;">
          UAE Express Delivery
        </h3>
        <p style="color: var(--color-text-muted); font-size: 0.875rem; line-height: 1.6;">
          Fast delivery in 1–2 business days across Dubai, Abu Dhabi, and Northern Emirates. Complimentary on orders over AED 250.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 2.25rem 1.75rem; transition: transform 0.3s ease;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--color-secondary-bg); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; color: var(--color-primary);">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.5rem;">
          100% Authentic Quality
        </h3>
        <p style="color: var(--color-text-muted); font-size: 0.875rem; line-height: 1.6;">
          Every item is crafted from certified medical-grade silicone, natural crystal minerals, or bio-active cosmetic formulations.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 2.25rem 1.75rem; transition: transform 0.3s ease;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--color-secondary-bg); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; color: var(--color-primary);">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.5rem;">
          Cash on Delivery & Apple Pay
        </h3>
        <p style="color: var(--color-text-muted); font-size: 0.875rem; line-height: 1.6;">
          Full flexibility to inspect at your door and pay with Cash on Delivery across the Emirates, or complete instant checkout with Apple Pay.
        </p>
      </div>

      <!-- Pillar 4 -->
      <div style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 2.25rem 1.75rem; transition: transform 0.3s ease;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--color-secondary-bg); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; color: var(--color-primary);">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--color-primary); margin-bottom: 0.5rem;">
          Luxury Vanity Unboxing
        </h3>
        <p style="color: var(--color-text-muted); font-size: 0.875rem; line-height: 1.6;">
          Presented in embossed silk-touch bespoke packaging with detailed user guidance manuals, arriving ready for gifting.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow badge",
      "default": "THE FABFADDONS DISTINCTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Beauty Connoisseurs Choose Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Uncompromising standards of quality, dispatch velocity, and concierge client care."
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us"
    }
  ]
}
{% endschema %}
