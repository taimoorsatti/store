{% comment %}
  Renders a price value with compare-at price
  Accepts: product {Object}
{% endcomment %}
<div class="price">
  <span class="price-item price-item--regular" style="font-weight: 700; color: var(--color-primary);">
    {{ product.price | money }}
  </span>
  {%- if product.compare_at_price > product.price -%}
    <span class="price-item price-item--sale" style="font-size: 0.85em; text-decoration: line-through; color: var(--color-text-muted); margin-left: 0.5rem;">
      {{ product.compare_at_price | money }}
    </span>
  {%- endif -%}
</div>
