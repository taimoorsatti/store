<div id="cart-drawer-overlay" class="cart-drawer-overlay"></div>
<aside id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}">
  <!-- Drawer Header -->
  <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between; background: #FFFFFF;">
    <div style="display: flex; align-items: center; gap: 0.6rem;">
      <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--color-primary); margin: 0;">{{ 'sections.cart.title' | t }}</h2>
      <span data-cart-count-badge style="background: var(--color-primary); color: #FFF; font-size: 10px; font-weight: 700; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
        {{ cart.item_count | default: 0 }}
      </span>
    </div>
    <button data-cart-drawer-close aria-label="Close cart drawer" style="font-size: 1.6rem; color: var(--color-text-muted); line-height: 1;">&times;</button>
  </div>

  <!-- Free Shipping Progress Meter -->
  <div class="free-shipping-bar">
    <div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: 700; color: var(--color-primary);">
      <span data-shipping-message>
        {% assign threshold_cents = settings.free_shipping_threshold | default: 250 | times: 100 %}
        {% if cart.total_price >= threshold_cents %}
          {{ 'sections.cart.free_shipping_unlocked' | t }}
        {% else %}
          {% assign away = threshold_cents | minus: cart.total_price | money %}
          {{ 'sections.cart.free_shipping_away' | t: amount: away }}
        {% endif %}
      </span>
    </div>
    <div class="progress-meter">
      {% assign pct = cart.total_price | times: 100 | divided_by: threshold_cents %}
      {% if pct > 100 %}{% assign pct = 100 %}{% endif %}
      <div class="progress-meter__fill" data-shipping-progress style="width: {{ pct }}%;"></div>
    </div>
  </div>

  <!-- Items Container -->
  <div style="flex: 1; overflow-y: auto; padding: 1.5rem;">
    <!-- Empty State -->
    <div id="cart-drawer-empty-state" style="{% if cart.item_count > 0 %}display: none;{% else %}display: block;{% endif %} text-align: center; padding: 3.5rem 1rem;">
      <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--color-secondary-bg); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; color: var(--color-primary);">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </div>
      <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="font-size: 11px;">{{ 'general.continue_shopping' | t }}</a>
    </div>

    <!-- Filled Items List -->
    <ul id="cart-drawer-items-list" style="{% if cart.item_count == 0 %}display: none;{% else %}display: flex;{% endif %} list-style: none; flex-direction: column; gap: 1rem;">
      {%- for item in cart.items -%}
        <li style="display: flex; gap: 1rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; align-items: center;">
          <img src="{{ item.image | default: 'hero-luxury-beauty-ritual.jpg' | asset_url }}" alt="{{ item.title }}" style="width: 72px; height: 72px; object-fit: cover; border-radius: 4px; border: 1px solid var(--color-border);">
          <div style="flex: 1;">
            <h4 style="font-size: 0.9rem; font-weight: 700; line-height: 1.3;"><a href="{{ item.url }}" style="color: var(--color-primary);">{{ item.title }}</a></h4>
            <div style="margin-top: 6px; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.825rem; font-weight: 600; color: var(--color-text-muted);">Qty: {{ item.quantity }}</span>
              <span style="font-weight: 700; color: var(--color-primary); font-size: 0.95rem;">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <!-- Drawer Footer -->
  <div id="cart-drawer-footer" style="{% if cart.item_count == 0 %}display: none;{% else %}display: block;{% endif %} padding: 1.5rem; border-top: 1px solid var(--color-border); background: #FFFFFF;">
    <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--color-primary);">
      <span>{{ 'sections.cart.subtotal' | t }}</span>
      <span data-cart-drawer-subtotal>{{ cart.total_price | money }}</span>
    </div>
    <p style="font-size: 0.75rem; color: var(--color-text-muted); margin-bottom: 1.25rem;">
      {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t }}
    </p>
    <div style="display: flex; flex-direction: column; gap: 0.6rem;">
      <a href="/checkout" class="btn-primary" style="width: 100%; text-align: center;">
        {{ 'sections.cart.checkout' | t }} &rarr;
      </a>
      <a href="/cart" class="btn-secondary" style="width: 100%; text-align: center; font-size: 11px; padding: 0.65rem 1rem;">
        {{ 'sections.cart.view_cart' | t }}
      </a>
    </div>
  </div>
</aside>
